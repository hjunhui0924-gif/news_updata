{
  "name": "news-updata",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "worker:dev": "tsx watch --env-file=.env.local src/worker/main.ts",
    "build": "next build && tsup src/worker/main.ts --format esm --platform node --out-dir dist/worker --external pg-native",
    "start": "next start --hostname 127.0.0.1",
    "worker:start": "node --env-file=.env.local scripts/start-worker.mjs",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:starred": "playwright test --config playwright.starred.config.ts",
    "test:e2e:ai": "playwright test --config playwright.ai.config.ts",
    "test:e2e:discovery": "playwright test --config playwright.discovery.config.ts",
    "test:e2e:following": "playwright test --config playwright.following.config.ts",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "format": "prettier --write src tests scripts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@radix-ui/react-dialog": "1.1.23",
    "better-auth": "1.7.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
