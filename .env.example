NEXT_TELEMETRY_DISABLED=1
# Copy to .env.local. Demo is local-only and never enabled automatically in production.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://news:news_local_only@127.0.0.1:54329/news
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_IDS=
GITHUB_READ_TOKEN=
# auto enables only on loopback. Public deployments always block server-local directories.
LOCAL_SKILLS_ENABLED=auto
# Enable YouTube Data API v3 in your own project. Server-only, never NEXT_PUBLIC_.
YOUTUBE_API_KEY=
# Google OAuth Web application. Redirect URI: <APP_URL>/api/platforms/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LLM_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_PERSONAL_ALLOWED_BASE_URLS=
LLM_MODEL=
# auto omits this provider-specific parameter; Qwen supports true/false.
LLM_ENABLE_THINKING=auto
LLM_DAILY_BUDGET_USD=0.5
LLM_MONTHLY_BUDGET_USD=5
LLM_GLOBAL_DAILY_BUDGET_USD=5
LLM_GLOBAL_MONTHLY_BUDGET_USD=50
API_READ_LIMIT_PER_MINUTE=600
API_WRITE_LIMIT_PER_MINUTE=60
API_EXTERNAL_LIMIT_PER_MINUTE=30
API_AI_LIMIT_PER_MINUTE=10
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
SYNC_REPO_INTERVAL_MINUTES=15
SYNC_AUTHOR_INTERVAL_MINUTES=30
SYNC_STAR_INTERVAL_MINUTES=5
SYNC_YOUTUBE_INTERVAL_MINUTES=180
LOG_LEVEL=info
