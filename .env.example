NEXT_TELEMETRY_DISABLED=1
# Copy to .env.local. Demo is local-only and never enabled automatically in production.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://news:news_local_only@127.0.0.1:54329/news
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_IDS=
GITHUB_READ_TOKEN=
LLM_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_BUDGET_USD=0.5
LLM_MONTHLY_BUDGET_USD=5
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
SYNC_REPO_INTERVAL_MINUTES=15
SYNC_AUTHOR_INTERVAL_MINUTES=30
SYNC_STAR_INTERVAL_MINUTES=5
LOG_LEVEL=info
